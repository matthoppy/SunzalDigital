{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunzal-seo-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // The dashboard UI. run_worker_first keeps it behind the password check.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "triggers": {
    "crons": [
      "*/10 * * * *", // uptime checks for every site
      "20 * * * *"    // daily data sync, a few sites per run
    ]
  },

  "vars": {
    // Your Supabase project URL, e.g. "https://abcdefghijkl.supabase.co"
    "SUPABASE_URL": "",
    // Public URL of this worker, used for DataForSEO result callbacks,
    // e.g. "https://sunzal-seo-dashboard.<you>.workers.dev"
    "PUBLIC_URL": "",
    "SITES_PER_RUN": "1",
    "PAGE_CHECKS_PER_SITE": "5",
    "RANK_CHECK_INTERVAL_DAYS": "1",
    "RANK_DEPTH": "30",
    "RANK_LANGUAGE_CODE": "en",
    "INDEX_CHECKS_PER_SITE": "5",
    // Write a fresh AI summary after each daily sync (needs ANTHROPIC_API_KEY)
    "DAILY_AI_SUMMARY": "true"
  }
}
